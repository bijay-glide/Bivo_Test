{
  "name": "playwright-bivo-api-tests",
  "version": "1.0.0",
  "description": "Playwright API testing suite for Bijay Workspace Client Account APIs",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "show:report": "playwright show-report",

    "pw:ui": "playwright test --ui",
    "pw:ui:api": "playwright test --ui --project=\"API Tests\"",
    "pw:ui:userweb": "playwright test --ui --project=\"UI user-web onboarding\" --project=\"UI user-web parallel\" --project=\"UI user-web link card only\" --project=\"UI user-web FX multi-country\"",

    "test:api": "playwright test --project=\"API Tests\" tests/api/",
    "test:api:create": "playwright test --project=\"API Tests\" tests/api/01-create-client-account.spec.js",
    "test:api:read": "playwright test --project=\"API Tests\" tests/api/02-account-read-operations.spec.js",
    "test:api:write": "playwright test --project=\"API Tests\" tests/api/03-account-write-operations.spec.js",
    "test:api:negative": "playwright test --project=\"API Tests\" tests/api/04-account-negative-scenarios.spec.js",
    "test:api:extended": "playwright test --project=\"API Tests\" tests/api/05-extended-account-apis.spec.js",
    "test:api:beneficiary-mgmt": "playwright test --project=\"API Tests\" tests/api/06-beneficiary-management.spec.js",
    "test:api:fx": "playwright test --project=\"API Tests\" tests/api/07-fx-payment.spec.js",
    "test:api:beneficiary": "playwright test --project=\"API Tests\" tests/api/08-beneficiary-and-currency.spec.js",
    "test:api:wire": "playwright test --project=\"API Tests\" tests/api/09-wire-instructions.spec.js",
    "test:api:ach": "playwright test --project=\"API Tests\" tests/api/10-ach-external-accounts.spec.js",
    "test:api:fx-integrity": "playwright test --project=\"API Tests\" tests/api/11-fx-quote-integrity.spec.js",
    "test:api:partner-individual": "playwright test --project=\"API Tests\" tests/api/bivo-partner-individual-account.spec.js",

    "test:ui:bcr": "playwright test --project=\"UI BCR onboarding\" --project=\"UI BCR parallel\"",
    "test:ui:bcr:onboarding": "playwright test --project=\"UI BCR onboarding\"",
    "test:ui:bcr:wire": "playwright test --no-deps --project=\"UI BCR parallel\" \"tests/ui/bcr/1.4 ui_bcr_setup_wire_payment.spec.js\"",
    "test:ui:bcr:fx": "playwright test --no-deps --project=\"UI BCR parallel\" \"tests/ui/bcr/1.5 ui_bcr_fx_transaction.spec.js\"",

    "test:ui:userweb:full": "rm -rf blob-report; PWTEST_BLOB_DO_NOT_REMOVE=1 playwright test --workers=1 --project=\"UI user-web onboarding\" --reporter=blob,list; e1=$?; PWTEST_BLOB_DO_NOT_REMOVE=1 playwright test --workers=5 --no-deps --project=\"UI user-web parallel\" --project=\"UI user-web link card only\" --project=\"UI user-web FX multi-country\" --reporter=blob,list; e2=$?; playwright merge-reports --config=playwright.config.js ./blob-report; if [ $e1 -ne 0 ] || [ $e2 -ne 0 ]; then exit 1; fi",
    "test:ui:userweb:onboarding": "playwright test --workers=1 --project=\"UI user-web onboarding\"",
    "test:ui:userweb:no-onboarding": "playwright test --no-deps --workers=4 --project=\"UI user-web parallel\" --project=\"UI user-web link card only\" --project=\"UI user-web FX multi-country\"",
    "test:ui:userweb:wire": "playwright test --no-deps --project=\"UI user-web parallel\" \"tests/ui/user-web/2-wire-payment/1-wire-payment.spec.js\"",
    "test:ui:userweb:withdraw": "playwright test --no-deps --project=\"UI user-web parallel\" \"tests/ui/user-web/2-withdraw-funds/1-withdraw-funds.spec.js\"",
    "test:ui:userweb:us-ach": "playwright test --no-deps --project=\"UI user-web parallel\" \"tests/ui/user-web/3-us-ach/1-us-ach.spec.js\"",
    "test:ui:userweb:link-card": "playwright test --no-deps --project=\"UI user-web link card only\"",
    "test:ui:userweb:fx-multi": "playwright test --workers=8 --no-deps --project=\"UI user-web FX multi-country\"",
    "test:ui:userweb:fx-multi:individual": "playwright test --workers=8 --no-deps --project=\"UI user-web FX multi-country\" \"tests/ui/user-web/5.1-fx-multicountry/1-fx-multicountry.spec.js\"",
    "test:ui:userweb:fx-multi:business": "playwright test --workers=8 --no-deps --project=\"UI user-web FX multi-country\" \"tests/ui/user-web/5.2-fx-multicountry-business/1-fx-multicountry-business.spec.js\"",
    "test:ui:userweb:uk-fx": "playwright test --workers=8 --no-deps --project=\"UI user-web FX multi-country\" \"tests/ui/user-web/5.3-uk-fx/1-uk-fx.spec.js\"",
    "test:ui:userweb:payee-fx": "playwright test --no-deps --project=\"UI user-web FX multi-country\" \"tests/ui/user-web/5.4-payee-fx/1-payee-fx.spec.js\"",
    "test:ui:userweb:india-fx": "playwright test --no-deps --project=\"UI user-web FX multi-country\" \"tests/ui/user-web/5.5-india-fx/1-india-fx.spec.js\"",
    "test:ui:userweb:mexico-fx": "playwright test --no-deps --project=\"UI user-web FX multi-country\" \"tests/ui/user-web/5.6-mexico-fx/1-mexico-fx.spec.js\"",
    "test:ui:userweb:move-money": "playwright test --headed --no-deps --project=\"UI user-web parallel\" \"tests/ui/user-web/6-move-money/1-move-money.spec.js\"",
    "test:ui:userweb:add-payee": "playwright test --no-deps --project=\"UI user-web parallel\" \"tests/ui/user-web/7-add-payee/1-add-payee.spec.js\"",
    "test:ui:userweb:settings-auth": "playwright test --no-deps --project=\"UI user-web parallel\" \"tests/ui/user-web/8-settings-auth/1-settings-auth.spec.js\"",
    "test:ui:userweb:accounts": "playwright test --no-deps --project=\"UI user-web parallel\" \"tests/ui/user-web/9.1-add-account/1-add-account.spec.js\" \"tests/ui/user-web/9.2-multicurrency-account/1-multicurrency-account.spec.js\"",
    "test:ui:userweb:add-account": "playwright test --no-deps --project=\"UI user-web parallel\" \"tests/ui/user-web/9.1-add-account/1-add-account.spec.js\"",
    "test:ui:userweb:multicurrency": "playwright test --no-deps --project=\"UI user-web parallel\" \"tests/ui/user-web/9.2-multicurrency-account/1-multicurrency-account.spec.js\"",

    "test:ui:buweb:full": "rm -rf blob-report; PWTEST_BLOB_DO_NOT_REMOVE=1 playwright test --workers=5 --project=\"UI bu-web onboarding\" --project=\"UI bu-web parallel\" --project=\"UI bu-web accounts\" --reporter=blob,list; e1=$?; PWTEST_BLOB_DO_NOT_REMOVE=1 playwright test --no-deps --workers=4 --project=\"UI bu-web sec-account\" --reporter=blob,list; e2=$?; playwright merge-reports --config=playwright.config.js ./blob-report; if [ $e1 -ne 0 ] || [ $e2 -ne 0 ]; then exit 1; fi",
    "test:ui:buweb:onboarding": "playwright test --workers=1 --project=\"UI bu-web onboarding\"",
    "test:ui:buweb:wire": "playwright test --no-deps --project=\"UI bu-web parallel\" \"tests/ui/bu-web/2-wire-payment/1-wire-payment.spec.js\"",
    "test:ui:buweb:withdraw": "playwright test --no-deps --project=\"UI bu-web parallel\" \"tests/ui/bu-web/2.1-withdraw-funds/1-withdraw-funds.spec.js\"",
    "test:ui:buweb:us-ach": "playwright test --no-deps --project=\"UI bu-web parallel\" \"tests/ui/bu-web/3-us-ach/1-us-ach.spec.js\"",
    "test:ui:buweb:link-card": "playwright test --no-deps --project=\"UI bu-web parallel\" \"tests/ui/bu-web/4-link-card/1-link-card.spec.js\"",
    "test:ui:buweb:fx-multi": "playwright test --no-deps --project=\"UI bu-web parallel\" \"tests/ui/bu-web/5.1-fx-multicountry/1-fx-multicountry.spec.js\" \"tests/ui/bu-web/5.2-fx-multicountry-business/1-fx-multicountry-business.spec.js\" \"tests/ui/bu-web/5.4-uk-fx/1-uk-fx.spec.js\"",
    "test:ui:buweb:fx-multi:individual": "playwright test --no-deps --project=\"UI bu-web parallel\" \"tests/ui/bu-web/5.1-fx-multicountry/1-fx-multicountry.spec.js\"",
    "test:ui:buweb:fx-multi:business": "playwright test --no-deps --project=\"UI bu-web parallel\" \"tests/ui/bu-web/5.2-fx-multicountry-business/1-fx-multicountry-business.spec.js\"",
    "test:ui:buweb:payee-fx": "playwright test --no-deps --project=\"UI bu-web parallel\" \"tests/ui/bu-web/5.3-payee-fx/1-payee-fx.spec.js\"",
    "test:ui:buweb:uk-fx": "playwright test --no-deps --project=\"UI bu-web parallel\" \"tests/ui/bu-web/5.4-uk-fx/1-uk-fx.spec.js\"",
    "test:ui:buweb:india-fx": "playwright test --no-deps --project=\"UI bu-web parallel\" \"tests/ui/bu-web/5.5-india-fx/1-india-fx.spec.js\"",
    "test:ui:buweb:mexico-fx": "playwright test --no-deps --project=\"UI bu-web parallel\" \"tests/ui/bu-web/5.6-mexico-fx/1-mexico-fx.spec.js\"",
    "test:ui:buweb:move-money": "playwright test --no-deps --project=\"UI bu-web parallel\" \"tests/ui/bu-web/6-move-money/1-move-money.spec.js\"",
    "test:ui:buweb:add-payee": "playwright test --no-deps --project=\"UI bu-web parallel\" \"tests/ui/bu-web/7-add-payee/1-add-payee.spec.js\"",
    "test:ui:buweb:settings-auth": "playwright test --no-deps --project=\"UI bu-web parallel\" \"tests/ui/bu-web/8-settings-auth/1-settings-auth.spec.js\"",
    "test:ui:buweb:accounts": "playwright test --no-deps --project=\"UI bu-web accounts\"",
    "test:ui:buweb:add-account": "playwright test --no-deps --project=\"UI bu-web accounts\" \"tests/ui/bu-web/9.1-add-account/1-add-account.spec.js\"",
    "test:ui:buweb:multicurrency": "playwright test --no-deps --project=\"UI bu-web accounts\" \"tests/ui/bu-web/9.2-multicurrency-account/1-multicurrency-account.spec.js\"",
    "test:ui:buweb:add-money-sec": "playwright test --no-deps --project=\"UI bu-web sec-account\"",

    "capture:apis": "CAPTURE_APIS=1 playwright test --no-deps --project=\"UI user-web parallel\" \"tests/ui/user-web/2-withdraw-funds/1-withdraw-funds.spec.js\" \"tests/ui/user-web/3-us-ach/1-us-ach.spec.js\" \"tests/ui/user-web/6-move-money/1-move-money.spec.js\"",
    "capture:apis:linkcard": "CAPTURE_APIS=1 playwright test --no-deps --project=\"UI user-web link card only\"",
    "capture:apis:fx": "CAPTURE_APIS=1 playwright test --workers=8 --no-deps --project=\"UI user-web FX multi-country\"",
    "api:summary": "node scripts/api-summary.js",
    "api:summary:json": "node scripts/api-summary.js --json",

    "k6:probe": "set -a && source .env && set +a && k6 run k6/device-trust-probe.js",
    "k6:load": "set -a && source .env && set +a && k6 run -e BIVO_VUS=$(node -pe \"require('./k6/phones.json').length\") k6/load-test.js",
    "k6:load:dashboard": "set -a && source .env && set +a && k6 run -e BIVO_VUS=$(node -pe \"require('./k6/phones.json').length\") --out web-dashboard k6/load-test.js"
  },
  "keywords": [
    "playwright",
    "api-testing",
    "automation",
    "testing"
  ],
  "author": "Bijay",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^10.2.0",
    "@playwright/test": "^1.57.0",
    "dotenv": "^16.3.1"
  },
  "dependencies": {
    "otplib": "^12.0.1"
  }
}
